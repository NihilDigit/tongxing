# LightWay 本地配置模板
#
# 复制此文件为 local.properties 并填入你的配置
# local.properties 已在 .gitignore 中，不会被提交

# Android SDK 路径
sdk.dir=/path/to/your/Android/Sdk

# ============================================================
# MCP 服务 URL 配置
# ============================================================
# 从 ModelScope MCP 广场获取你的个人托管 URL:
# https://modelscope.cn/mcp
# 
# 每个服务的 URL 格式: https://mcp.api-inference.modelscope.net/{YOUR_ID}/mcp

# 核心服务 (Core Services)
mcp.amap.url=

# 出行服务 (Travel Services)
mcp.12306.url=
mcp.variflight.url=

# 滴滴打车 (DiDi Taxi) - 沙箱环境，不会产生真实订单
# 申请地址: https://mcp.didichuxing.com
# 沙箱地址格式: https://mcp.didichuxing.com/mcp-servers-sandbox?key=YOUR_API_KEY
mcp.didi.sandbox.url=

# ============================================================
# 云端 API Key（DashScope / ModelScope）
# ============================================================
# 用于云端 LLM 和云端 MCP 服务
# 获取地址: https://dashscope.console.aliyun.com/
cloudApiKey=
