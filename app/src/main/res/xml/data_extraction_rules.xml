<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- This preferences file contains the user's cloud API key. -->
        <exclude domain="sharedpref" path="lightway_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lightway_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
